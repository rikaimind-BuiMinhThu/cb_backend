default: &default
  adapter: mysql2
  encoding: utf8mb4
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  username: root
  password:
  socket: /var/run/mysqld/mysqld.sock

development:
  <<: *default
  database: instagram_chatbot

test:
  <<: *default
  database: instagram_chatbot_test

production:
  <<: *default
  database: instagram_chatbot_production
