<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
</head>
<body>
  <p>Shop name: <%= @content[:shop_name]%></p>
  <p>User email: <%= @content[:user_email]%></p>
  <% if @content[:path].present? %>
    <p>Order type: <%= @content[:path]%></p>
  <% end %>
  <% if @content[:error_kind].present? %>
    <p>Error: <%= @content[:error_kind]%> — <%= @content[:error_message]%></p>
  <% end %>
  <% if @content[:user_input_id].present? %>
    <p>User input: <%= @content[:user_input_id]%></p>
  <% end %>
</body>
</html>
