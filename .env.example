# Copy to .env / .env.development / .env.staging / .env.production and fill in values.
# dotenv-rails loads: .env.{RAILS_ENV}.local, .env.local, .env.{RAILS_ENV}, .env
# Existing OS/Docker ENV is not overwritten.
#
# SETTINGS__* overrides Settings.* after YAML load (config.use_env).
# Example: SETTINGS__CHATBOT_DOMAIN=

# --- Public URLs ---
CHATBOT_DOMAIN=

# --- Database ---
RAILS_DATABASE_USERNAME=
RAILS_DATABASE_PASSWORD=
RAILS_DATABASE_HOST=
RAILS_DATABASE=
# RAILS_MAX_THREADS=5

# --- Redis ---
REDIS_URL=

# --- Mail ---
GMAIL_USERNAME=
GMAIL_PASSWORD=

# --- Active Record encryption ---
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Settings (settings.yml) ---
WEBHOOK_VERIFY_TOKEN=
PAGE_FACEBOOK_ACCESS_TOKEN=
PAGE_INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
AWS_REGION=
TWO_CAPTCHA_API_KEY=
CAPTCHA_CLIENT_KEY=
SMS_CODE=
SMS_CLIENT_ID=
SMS_TOKEN=

# --- secrets.yml ---
SECRET_KEY_BASE=
SECRET_REFRESH_TOKEN=
SCENARIO_ENCRYPTION_SECRET_KEY=
SHOPIFY_SHOP_NAME=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ACCESS_TOKEN=

# --- Optional ---
# RAILS_LOG_LEVEL=
# RAILS_SERVE_STATIC_FILES=
# RAILS_LOG_TO_STDOUT=
# WEB_CONCURRENCY=
#
# SETTINGS__CHATBOT_DOMAIN=
# SETTINGS__WEBHOOK__VERIFY_TOKEN=
# SETTINGS__FACEBOOK__META_APP__APP_ID=
# SETTINGS__AWS__S3__AWS_ACCESS_KEY_ID=
# SETTINGS__API__TIME_RESET_TOKEN=
